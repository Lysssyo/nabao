# Copy to .env for Docker Compose; use new local values.
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-password
INTERNAL_API_KEY=replace-with-a-random-local-key
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
NABAO_BACKEND_IMAGE=nabao-backend:local
NABAO_COLLECTOR_IMAGE=nabao-collector:local
NABAO_LLM_BASE_URL=https://api.deepseek.com
NABAO_LLM_MODEL=deepseek-flash
NABAO_LLM_API_KEY=
NABAO_LLM_MAX_TOKENS=32768
NABAO_LLM_TIMEOUT_MS=180000
NABAO_LLM_THINKING_DISABLED=true

# Optional path inside the collector container, after provisioning a private session file.
NABAO_BROWSER_STORAGE_STATE=

# Remote push stays disabled until Apple signing and a runtime key mount are ready.
APNS_ENABLED=false
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_ENVIRONMENT=sandbox
# This is the readable path inside the backend container, never a build argument.
APNS_PRIVATE_KEY_PATH=
APNS_POLL_DELAY_MS=60000
# Local backend only; Compose uses its private persistent push-data volume.
NABAO_PUSH_STATE_FILE=.local/push/table-state.json
