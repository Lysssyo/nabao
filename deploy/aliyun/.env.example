# Copy to deploy/aliyun/.env on the server and chmod 600. Never commit real values.
# Keep project name "nabao" across every deployment to retain the five original volumes.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
INTERNAL_API_KEY=

# Set the exact images built from the SAME verified source revision.
# Prefer immutable image digests when a registry is used. Empty values are not deployable.
NABAO_BACKEND_IMAGE=
NABAO_COLLECTOR_IMAGE=
NABAO_CADDY_IMAGE=caddy:2-alpine
BACKEND_PORT=8080

NABAO_LLM_BASE_URL=https://api.deepseek.com
NABAO_LLM_MODEL=deepseek-flash
NABAO_LLM_API_KEY=
NABAO_LLM_MAX_TOKENS=32768
NABAO_LLM_TIMEOUT_MS=180000
NABAO_LLM_THINKING_DISABLED=true

# Keep disabled until login and one real collection have both been verified.
NABAO_CONTROL_SCHEDULE_ENABLED=false
NABAO_CONTROL_INTERVAL_MINUTES=360
APNS_ENABLED=false

# Leave empty for the initial SSH-only deployment. HTTPS requires a DNS hostname,
# without a scheme, path, port or wildcard, and a real certificate contact email.
NABAO_DOMAIN=
ACME_EMAIL=

# Starting budgets for the 2GiB host. These are limits, not preallocated memory.
MYSQL_MEMORY_LIMIT=384m
BACKEND_MEMORY_LIMIT=448m
COLLECTOR_MEMORY_LIMIT=768m
CADDY_MEMORY_LIMIT=64m
NABAO_JAVA_OPTIONS=-Xms64m -Xmx192m -XX:+ExitOnOutOfMemoryError
NABAO_NODE_OPTIONS=--max-old-space-size=256
