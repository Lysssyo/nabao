# CLI loads .env in its working directory; existing environment takes priority.
NABAO_DATA_DIR=./data
NABAO_BACKEND_URL=http://localhost:8080
# Must match the backend configuration.
NABAO_INTERNAL_KEY=
NABAO_LLM_BASE_URL=https://api.deepseek.com
NABAO_LLM_MODEL=deepseek-flash
NABAO_LLM_API_KEY=
NABAO_LLM_MAX_TOKENS=32768
NABAO_LLM_TIMEOUT_MS=180000
NABAO_LLM_THINKING_DISABLED=true
# Optional isolated login profile; never point this at your everyday browser.
NABAO_BROWSER_PROFILE=../.local/xhs-browser
# Use the locally installed Chrome for the dedicated profile when desired.
NABAO_BROWSER_CHANNEL=chrome
# Optional portable session file created only from the dedicated profile.
# NABAO_BROWSER_STORAGE_STATE=../.local/xhs-session.json
NABAO_TABLE_DIRECTORY=../.local/public

# Persistent control service (node dist/src/cli.js control).
# Keep this endpoint private; the Java backend authenticates and proxies it.
NABAO_CONTROL_HOST=127.0.0.1
NABAO_CONTROL_PORT=18082
# Defaults to NABAO_INTERNAL_KEY; must match backend NABAO_CONTROL_KEY.
# NABAO_CONTROL_KEY=
NABAO_CONTROL_SCHEDULE_ENABLED=true
NABAO_CONTROL_INTERVAL_MINUTES=360
# Collection browser mode. Keep false only when this runtime has a graphical desktop.
NABAO_CONTROL_HEADLESS=true
# Optional interactive login browser mode; checks and collection use NABAO_CONTROL_HEADLESS.
# On your Mac use false for a visible dedicated Chrome window and personal verification.
# NABAO_LOGIN_HEADLESS=false
# Optional local troubleshooting: fixed type/boolean/count diagnostics only; disabled by default.
# NABAO_LOGIN_DIAGNOSTICS=true
